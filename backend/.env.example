# Local server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Required for database-backed API routes and readiness health checks.
MONGO_URI=mongodb://localhost:27017/shopverse
# Optional comma-separated DNS resolver IPs for Atlas SRV lookup issues.
MONGODB_DNS_SERVERS=
# Optional; defaults to 5000 ms.
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# Required for signing and verifying login tokens.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
# Optional; defaults to 7 days.
JWT_COOKIE_EXPIRE=7

# Optional email delivery settings. Email delivery requires these in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.invalid
FROM_NAME=ShopVerse

# Optional for the existing Stripe payment endpoints/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
